# ---------------------------------------------------------------------------
# Supabase  (Project Settings → API / API Keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# "anon" (legado) ou "publishable" key — pode ficar exposta no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" (legado) ou "secret" key — NUNCA exponha. Somente servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend  (https://resend.com/api-keys)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Remetente com domínio verificado, ex.: "Connect Skin Academy <academy@suaempresa.com.br>"
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# URL pública sem barra no final, ex.: https://academy.suaempresa.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo da rotina diária (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>").
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Limite de upload de vídeo em MB. Plano Free do Supabase: máximo 50.
NEXT_PUBLIC_VIDEO_MAX_UPLOAD_MB=50
